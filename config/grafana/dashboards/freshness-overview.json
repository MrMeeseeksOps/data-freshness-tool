{
  "uid": "freshness-overview",
  "title": "Data Freshness Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total monitored tables",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(data_freshness_monitor_enabled)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Healthy tables",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((data_freshness_status == bool 0) * data_freshness:recent * data_freshness_monitor_enabled)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Warning tables",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((data_freshness_status == 1) and (data_freshness_monitor_enabled == 1)) or vector(0)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Stale tables",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((data_freshness_status == 2) and (data_freshness_monitor_enabled == 1)) or vector(0)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Error tables",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((data_freshness_status == 3) and (data_freshness_monitor_enabled == 1)) or vector(0)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Freshness compliance %",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum((data_freshness_status == bool 0) * data_freshness:recent * data_freshness_monitor_enabled) / clamp_min(sum(data_freshness_monitor_enabled),1)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Freshness trends",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_freshness_lag_seconds",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Top stale tables",
      "type": "table",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10,data_freshness_lag_seconds and (data_freshness_status == 2) and (data_freshness_monitor_enabled == 1))",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Tables by owner",
      "type": "barchart",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (owner_team) (data_freshness_monitor_enabled)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Last successful evaluator (Unix seconds)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_freshness_evaluator_last_success_timestamp_seconds",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Missing evaluations",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((data_freshness:recent == 0) and (data_freshness_monitor_enabled == 1)) or vector(0)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "annotations": {
    "list": []
  }
}
