{
  "uid": "system-health",
  "title": "Monitoring System Health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Prometheus targets",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Windows CPU utilization %",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(windows_cpu_time_total{mode=\"idle\"}[5m])))",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Memory utilization %",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - windows_memory_available_bytes / windows_memory_physical_total_bytes)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Disk used %",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - windows_logical_disk_free_bytes / windows_logical_disk_size_bytes)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Evaluator successful queries",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(data_freshness_evaluation_success * data_freshness_monitor_enabled)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Seconds since evaluator run",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - data_freshness_evaluator_last_success_timestamp_seconds",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Evaluation duration",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_freshness_evaluation_duration_seconds",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Snowflake/query failures",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshness-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((data_freshness_evaluation_success == bool 0) * data_freshness_monitor_enabled)",
          "legendFormat": "{{monitor_id}} {{owner_team}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "annotations": {
    "list": []
  }
}
