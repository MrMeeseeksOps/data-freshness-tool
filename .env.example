# Copy into the protected host config directory; never commit the populated file.
FRESHNESS_ACCOUNT=organization-account
FRESHNESS_USER=FRESHNESS_SERVICE
FRESHNESS_ROLE=FRESHNESS_RUNTIME
FRESHNESS_WAREHOUSE=MONITORING_WH
FRESHNESS_PRIVATE_KEY_FILE=C:\DataObservability\config\secrets\snowflake.p8
# Inject FRESHNESS_PRIVATE_KEY_PASSPHRASE from an approved secret store if encrypted.
FRESHNESS_DATABASE=DATA_OBSERVABILITY
FRESHNESS_METRICS_FILE=C:\DataObservability\data\textfile\freshness.prom
FRESHNESS_QUERY_TIMEOUT=60
FRESHNESS_WORKERS=4
FRESHNESS_RETRIES=2
